@startuml diagramma-1-aule
' Diagramma dei casi d'uso 1: gestione delle aule
left to right direction
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam titleFontSize 16
skinparam actorBorderColor #333333
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #FFFFFF
skinparam rectangleBorderColor #888888
skinparam arrowColor #333333

title Diagramma 1 – Gestione delle aule

actor "Impiegato della\nsegreteria" as Impiegato

rectangle "Prenotazione Aule" {
  usecase "UC1 Inserisci aula" as UC1
  usecase "UC2 Modifica aula" as UC2
  usecase "UC3 Elimina aula" as UC3
  usecase "UC4 Visualizza elenco aule" as UC4
  usecase "UC5 Cerca aula" as UC5
}

Impiegato -- UC1
Impiegato -- UC2
Impiegato -- UC3
Impiegato -- UC4
Impiegato -- UC5
@enduml
