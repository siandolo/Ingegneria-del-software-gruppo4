@startuml diagramma-3-prenotazioni
' Diagramma dei casi d'uso 3: prenotazioni
left to right direction
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam titleFontSize 16
skinparam actorBorderColor #333333
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #FFFFFF
skinparam rectangleBorderColor #888888
skinparam arrowColor #333333

title Diagramma 3 – Prenotazioni

actor "Impiegato della\nsegreteria" as Impiegato

rectangle "Prenotazione Aule" {
  usecase "UC11 Cerca aule disponibili" as UC11
  usecase "UC12 Inserisci prenotazione" as UC12
  usecase "UC13 Inserisci\nprenotazione singola" as UC13
  usecase "UC14 Inserisci\nprenotazione ricorrente" as UC14
  usecase "UC15 Verifica sovrapposizioni" as UC15
  usecase "UC16 Visualizza prenotazioni" as UC16
  usecase "UC17 Elimina prenotazione" as UC17
  usecase "UC18 Elimina prenotazioni\nfuture della serie" as UC18
}

Impiegato -- UC11
Impiegato -- UC12
Impiegato -- UC16
Impiegato -- UC17

' specializzazione: il triangolo punta al caso d'uso generale
UC12 <|-- UC14
UC12 <|-- UC13

' include: sempre eseguito; extend: solo in certe condizioni
UC12 ..> UC15 : <<include>>
UC17 <.. UC18 : <<extend>>
@enduml
